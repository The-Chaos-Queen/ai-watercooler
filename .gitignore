*.gguf
*.bin
*.safetensors
*.onnx
*.pt
*.pth
*.h5
*.db
*.sqlite
*.sqlite3

# Chrome profile (Cortex browser data, massive)
Project_Prosthetic/chrome_profile/
Projects/Project_Prosthetic/chrome_profile/

