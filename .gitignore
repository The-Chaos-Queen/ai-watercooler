# Temporary / cache
*.tmp
*.log
*.cache
tmp/
tmp_test_wc.sh
tmp_vastai_stub.sh
.claude/scheduled_tasks.lock

# Local triage holding area for generated/runtime/untracked files.
# Keep canonical docs, source, tests, specs, and runbooks out of this folder.
_Archive_untracked/

# Gemini/Antigravity internal state (has its own location)
# .gemini/ is outside this folder, so not needed here

# Media exports (large)
*.mp3
*.wav
*.mp4
*.webm
*.webp
*.png
*.jpg
*.jpeg
*.gif
*.pdf

# Node (if any future web projects)
node_modules/
package-lock.json

# Athena-Public has its own git repo, don't nest
Athena-Public/

# Local research/writing/memory exports — backed up via Google Drive, not repo-tracked
Research/
Writing/
memories*.json
organic_memories*.json
organic_memories*.jsonl

# Raw HTML exports / saved web pages (conversion inputs, large and messy)
html-to-convert/
Research/*.html
Research/*_files/

# Preserved History (backed up via rsync to Google Drive)
Preserved-History/

# Project MUD runtime artifacts
Project_MUD/agents/states/
Project_MUD/agents/training_data/

# Presentations and Office files
*.pptx
*.docx
*.xlsx

# Wolf folders — backed up via Google Drive sync, no change tracking needed
CHEESE_Memory/wolves/

# Ultrareview helper files — may carry session tokens; never committed
MoCoP/reviews/**/_wc_raw*.json
MoCoP/reviews/**/_wc_digest.txt

# Hermes agent workspace + context (may hold session tokens)
.hermes
.hermes/
.hermes.md

# Runtime logs, process files, and "latest" snapshots (regenerable / some private)
*.pid
*_latest.txt
*_latest.jsonl
*_log.jsonl
private_recall_log.jsonl
memory_formation_log.jsonl
failure_log.jsonl
chat_session_latest.txt

# Reincarnation / D2 eval run outputs — regenerable experiment artifacts
MoCoP/experiments/mamba_lora_bridge/run_reincarnation/

# Local ebook copies (copyrighted, large binary — not for the repo)
Research/books/
*.azw3
*.epub
*.mobi

# Embedded git repos — developed separately, must not nest as broken gitlinks
Research/titans-pytorch-mlx/
Projects/LegalAI/
tools/codesight/
tools/observability/

# Logit-lens image outputs (extensionless, not caught by media globs)
Research/lw_logit_lens/images/

# Windows shortcuts
*.lnk

# Ultrareview / lane-experiment temp outputs
LANE_EXP_BATCH*.txt
b4m69vkg1.txt
.claude/settings.local.json
.claude/settings.json

# Claude-in-Chrome / Playwright MCP scratch artifacts
.playwright-mcp/
