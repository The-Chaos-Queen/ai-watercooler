# Local triage holding area for generated/runtime/untracked files.
# Keep canonical docs, source, tests, specs, and runbooks out of this folder.
_Archive_untracked/

# Gemini/Antigravity internal state (has its own location)
# .gemini/ is outside this folder, so not needed here

# Media exports (large)
*.mp3
*.wav
*.mp4
*.webm
*.webp
*.png
*.jpg
*.jpeg
*.gif
*.pdf

# Node (if any future web projects)
node_modules/
package-lock.json

# Athena-Public has its own git repo, don't nest
Athena-Public/

# Raw HTML exports (conversion inputs, large and messy)
html-to-convert/

# Project MUD runtime artifacts
Project_MUD/agents/states/
Project_MUD/agents/training_data/

# Presentations and Office files
*.pptx
*.docx
*.xlsx
