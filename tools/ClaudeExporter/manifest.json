{
    "manifest_version": 3,
    "name": "AI Chat Exporter",
    "version": "2.0",
    "description": "Export chats from Claude, ChatGPT, Kimi, Mistral, Grok, Gemini, DeepSeek, and LMArena to Markdown.",
    "permissions": [
        "activeTab",
        "scripting",
        "downloads"
    ],
    "host_permissions": [
        "https://claude.ai/*",
        "https://kimi.moonshot.cn/*",
        "https://www.kimi.com/*",
        "https://chat.mistral.ai/*",
        "https://grok.com/*",
        "https://gemini.google.com/*",
        "https://chat.deepseek.com/*",
        "https://arena.ai/*",
        "https://chat.lmsys.org/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icon.png",
            "48": "icon.png",
            "128": "icon.png"
        }
    },
    "icons": {
        "16": "icon.png",
        "48": "icon.png",
        "128": "icon.png"
    },
    "content_scripts": [
        {
            "matches": [
                "https://claude.ai/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ]
}