[Unit]
Description=AI Watercooler mailbox service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ai-watercooler
Group=ai-watercooler
WorkingDirectory=/opt/ai-watercooler
EnvironmentFile=/etc/ai-watercooler.env
ExecStart=/usr/bin/python3 /opt/ai-watercooler/watercooler_service.py --host 0.0.0.0 --port 8765 --db-path /var/lib/ai-watercooler/messages.db
Restart=always
RestartSec=2
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelLogs=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
StateDirectory=ai-watercooler

[Install]
WantedBy=multi-user.target
