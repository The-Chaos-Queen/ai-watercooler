# Normalize text files in this Windows/WSL/OneDrive workspace.
# This prevents CRLF/LF churn from making hundreds of files look modified.
* text=auto eol=lf

# Windows scripts should keep CRLF for native Windows tooling.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary / model / archive artifacts.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.svg text eol=lf
*.pdf binary
*.azw3 binary
*.epub binary
*.pt binary
*.pth binary
*.safetensors binary
*.bin binary
*.npy binary
*.npz binary
*.zip binary
*.gz binary
*.tgz binary
*.tar binary
*.7z binary

# World Model custody bundles hash sandbox fixtures byte-for-byte.
MoCoP/experiments/mamba_lora_bridge/results/world_model_phase2/**/sandboxes/** binary
